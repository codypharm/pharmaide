# Browser-facing API base URL.
# Local:
VITE_API_BASE_URL=http://localhost:8000

# Production:
# VITE_API_BASE_URL=https://<backend-cloud-run-service-url>

# Frontend auth mode:
# - disabled: local development, backend accepts dev auth fallback.
# - gcip: browser must sign in and send Firebase/GCIP ID tokens.
VITE_AUTH_MODE=disabled

# Required when VITE_AUTH_MODE=gcip.
VITE_GCIP_API_KEY=
VITE_GCIP_AUTH_DOMAIN=
VITE_GCIP_PROJECT_ID=
