# Path to the SQLite checkpointer database used by LangGraph.
PHARMAIDE_CHECKPOINT_DB_PATH=./pharmaide.db

# Async SQLAlchemy DSN for the domain database.
# Default points at the local docker-compose Postgres.
PHARMAIDE_DATABASE_URL=postgresql+asyncpg://pharmaide:pharmaide@localhost:5432/pharmaide

# When true, mounts POST /debug/graph for end-to-end seam checks.
# Must remain false outside local dev.
PHARMAIDE_DEBUG_ROUTES_ENABLED=false

# Comma-separated browser origins allowed to call the API.
# Local:
PHARMAIDE_CORS_ALLOWED_ORIGINS=http://localhost:5173
# Production example:
# PHARMAIDE_CORS_ALLOWED_ORIGINS=https://<frontend-domain>

# Pharmacist-facing API auth:
# - disabled: local development, accepts X-Pharmaide-User-Id.
# - gcip: production/staging, requires Authorization: Bearer <GCIP/Firebase ID token>.
PHARMAIDE_AUTH_MODE=disabled
PHARMAIDE_GCIP_PROJECT_ID=

# "console" for colored dev output, "json" for production structured logs.
PHARMAIDE_LOG_MODE=console

# RxNorm/RxNav base URL used for medication grounding.
PHARMAIDE_RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# OpenAI key used by PydanticAI agents, safety fallback, and embedding calls.
# Store as a secret in production, not as a plaintext env file value.
PHARMAIDE_OPENAI_API_KEY=

# Manual live RAG eval. Uses real query embeddings against an already-ingested
# products.csv knowledge document. Leave disabled for normal test runs and
# production runtimes.
PHARMAIDE_RUN_LIVE_RAG_EVAL=0
PHARMAIDE_LIVE_RAG_QUERY_LIMIT=100
PHARMAIDE_LIVE_RAG_MIN_HIT_RATE_AT_5=0.6
PHARMAIDE_LIVE_RAG_MIN_MRR=0.4
PHARMAIDE_LIVE_RAG_MIN_PRECISION_AT_5=0.12
PHARMAIDE_LIVE_RAG_MIN_RECALL_AT_5=0.6


# To run locally:
# PHARMAIDE_RUN_LIVE_RAG_EVAL=1 uv run pytest tests/evaluations/test_live_rag_products_eval.py -q


# Meta WhatsApp webhook verification token for subscription setup.
# Store as a secret in production.
PHARMAIDE_WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta App Secret used to validate X-Hub-Signature-256 on webhook POSTs.
# Store as a secret in production.
PHARMAIDE_WHATSAPP_WEBHOOK_APP_SECRET=

# WhatsApp outbound delivery:
# - placeholder: local dev, marks queued messages as sent without contacting Meta.
# - cloud_api: sends text messages through Meta WhatsApp Cloud API.
PHARMAIDE_WHATSAPP_DELIVERY_PROVIDER=placeholder
# Required when PHARMAIDE_WHATSAPP_DELIVERY_PROVIDER=cloud_api.
# Store the access token as a secret in production.
PHARMAIDE_WHATSAPP_CLOUD_API_ACCESS_TOKEN=
PHARMAIDE_WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=
PHARMAIDE_WHATSAPP_CLOUD_API_VERSION=v25.0
PHARMAIDE_WHATSAPP_CLOUD_API_BASE_URL=https://graph.facebook.com

# Safety provider mode:
# - model: interim in-app typed PydanticAI safety checks.
# - remote_http: private Llama Guard / AgentDoG gateway.
# - unconfigured: fail closed.
PHARMAIDE_SAFETY_PROVIDER=model
PHARMAIDE_LLAMA_GUARD_URL=
PHARMAIDE_AGENTDOG_URL=
# Store as a secret in production when the safety gateway requires bearer auth.
PHARMAIDE_SAFETY_PROVIDER_API_KEY=
PHARMAIDE_SAFETY_PROVIDER_TIMEOUT_SECONDS=10

# Caps one treatment analysis run so a stuck graph cannot pin worker capacity.
PHARMAIDE_ANALYSIS_TIMEOUT_SECONDS=60

# Temporary pre-auth guard for local/dev analysis fanout.
PHARMAIDE_MAX_CONCURRENT_ANALYSES_PER_USER=3

# Local development storage for uploaded knowledge-base source files.
# Production should use durable object/blob storage, not Cloud Run instance disk.
PHARMAIDE_KNOWLEDGE_UPLOAD_DIR=./data/kb_uploads

# Accepts raw bytes or size strings such as 25MB.
PHARMAIDE_KNOWLEDGE_MAX_UPLOAD_BYTES=25MB

# How long an ingesting knowledge document can sit before cleanup marks it stale.
PHARMAIDE_KNOWLEDGE_INGESTION_STALE_MINUTES=30

# Internal worker route auth:
# - disabled: local development default.
# - oidc: production Cloud Tasks/Scheduler service-to-service identity tokens.
PHARMAIDE_INTERNAL_WORKER_AUTH=disabled
# In production, set to the backend Cloud Run URL/audience expected in OIDC
# tokens from Cloud Tasks/Scheduler.
PHARMAIDE_INTERNAL_WORKER_AUDIENCE=

# Background task backend:
# - in_process: local development default.
# - cloud_tasks: production durable queue path for named internal worker jobs.
PHARMAIDE_TASK_BACKEND=in_process

# Required only when PHARMAIDE_TASK_BACKEND=cloud_tasks.
# Queue path format: projects/<project>/locations/<region>/queues/<queue>
PHARMAIDE_CLOUD_TASKS_QUEUE_PATH=
# Public HTTPS base URL of the backend Cloud Run service.
PHARMAIDE_CLOUD_TASKS_BASE_URL=
# Service account used by Cloud Tasks to invoke internal routes.
PHARMAIDE_CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
# Usually the backend Cloud Run service URL unless a custom audience is used.
PHARMAIDE_CLOUD_TASKS_OIDC_AUDIENCE=
