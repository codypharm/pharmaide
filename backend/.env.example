# Path to the SQLite checkpointer database used by LangGraph.
PHARMAIDE_CHECKPOINT_DB_PATH=./pharmaide.db

# Async SQLAlchemy DSN for the domain database.
# Default points at the local docker-compose Postgres.
PHARMAIDE_DATABASE_URL=postgresql+asyncpg://pharmaide:pharmaide@localhost:5432/pharmaide

# When true, mounts POST /debug/graph for end-to-end seam checks.
# Must remain false outside local dev.
PHARMAIDE_DEBUG_ROUTES_ENABLED=false

# "console" for colored dev output, "json" for prod-shaped structured logs.
PHARMAIDE_LOG_MODE=console

# RxNorm/RxNav base URL used for medication grounding.
PHARMAIDE_RXNORM_BASE_URL=https://rxnav.nlm.nih.gov/REST

# OpenAI key used by PydanticAI agents and embedding calls.
PHARMAIDE_OPENAI_API_KEY=

# Safety provider mode:
# - model: interim in-app typed PydanticAI safety checks.
# - remote_http: private Llama Guard / AgentDoG gateway.
# - unconfigured: fail closed.
PHARMAIDE_SAFETY_PROVIDER=model
PHARMAIDE_LLAMA_GUARD_URL=
PHARMAIDE_AGENTDOG_URL=
PHARMAIDE_SAFETY_PROVIDER_API_KEY=
PHARMAIDE_SAFETY_PROVIDER_TIMEOUT_SECONDS=10

# Caps one treatment analysis run so a stuck graph cannot pin worker capacity.
PHARMAIDE_ANALYSIS_TIMEOUT_SECONDS=60

# Temporary pre-auth guard for local/dev analysis fanout.
PHARMAIDE_MAX_CONCURRENT_ANALYSES_PER_USER=3

# Local development storage for uploaded knowledge-base source files.
PHARMAIDE_KNOWLEDGE_UPLOAD_DIR=./data/kb_uploads

# Accepts raw bytes or size strings such as 25MB.
PHARMAIDE_KNOWLEDGE_MAX_UPLOAD_BYTES=25MB

# How long an ingesting knowledge document can sit before cleanup marks it stale.
PHARMAIDE_KNOWLEDGE_INGESTION_STALE_MINUTES=30

# Background task backend:
# - in_process: local development default.
# - cloud_tasks: production durable queue path. The real Google client is not wired yet.
PHARMAIDE_TASK_BACKEND=in_process

# Required only when PHARMAIDE_TASK_BACKEND=cloud_tasks.
PHARMAIDE_CLOUD_TASKS_QUEUE_PATH=
PHARMAIDE_CLOUD_TASKS_BASE_URL=
PHARMAIDE_CLOUD_TASKS_OIDC_AUDIENCE=
